// Função para buscar dólar atualizado
async function fetchDollarRate(){
  var apis=[
    'https://economia.awesomeapi.com.br/json/last/USD-BRL',
    'https://api.exchangerate-api.com/v4/latest/USD'
  ];
  try{
    // Tenta AwesomeAPI primeiro (CORS liberado)
    var res=await fetch('https://economia.awesomeapi.com.br/json/last/USD-BRL');
    var data=await res.json();
    if(data && data.USDBRL && data.USDBRL.bid){
      var rate=parseFloat(data.USDBRL.bid);
      BRL=rate;
      localStorage.setItem(DOLLAR_KEY, rate.toString());
      localStorage.setItem(DOLLAR_DATE_KEY, new Date().toISOString());
      addLog('💵 Dólar atualizado: R$ '+rate.toFixed(2)+' (fonte: AwesomeAPI)');
      updateDollarDisplay();
      render(); // re-render para atualizar valores em R$
      return rate;
    }
  }catch(e){
    console.log('AwesomeAPI falhou', e);
    addLog('⚠️ Tentando fonte alternativa do dólar...');
  }
  try{
    var res2=await fetch('https://open.er-api.com/v6/latest/USD');
    var data2=await res2.json();
    if(data2 && data2.rates && data2.rates.BRL){
      var rate2=data2.rates.BRL;
      BRL=rate2;
      localStorage.setItem(DOLLAR_KEY, rate2.toString());
      localStorage.setItem(DOLLAR_DATE_KEY, new Date().toISOString());
      addLog('💵 Dólar atualizado: R$ '+rate2.toFixed(2)+' (fonte: ER-API)');
      updateDollarDisplay();
      render();
      return rate2;
    }
  }catch(e2){
    addLog('⚠️ Não foi possível atualizar dólar agora, usando R$ '+BRL.toFixed(2)+' salvo');
  }
  return null;
}
