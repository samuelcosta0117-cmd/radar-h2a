.controls{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
input,select{background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:10px;padding:9px 12px;font-size:13px;outline:none}
input{flex:1;min-width:180px}
input::placeholder{color:var(--dim)}
.count{color:var(--muted);font-size:12px;align-self:center}
.tablewrap{overflow-x:auto;border:1px solid var(--border);border-radius:14px}
table{width:100%;border-collapse:collapse;min-width:860px}
th{background:var(--green2);color:#fff;font-size:11px;text-transform:uppercase;letter-spacing:.04em;padding:10px 10px;text-align:left;position:sticky;top:0}
td{padding:10px 10px;border-top:1px solid var(--border);font-size:13px;vertical-align:top}
tr:nth-child(even) td{background:rgba(255,255,255,.015)}
.r{text-align:right}.c{text-align:center}
.pill{display:inline-block;border-radius:999px;padding:2px 9px;font-size:11px;font-weight:700}
.hi{background:rgba(63,174,90,.15);color:#7fd99a;border:1px solid rgba(63,174,90,.3)}
.mid{background:rgba(224,169,46,.14);color:#edc877;border:1px solid rgba(224,169,46,.3)}
.lo{background:rgba(229,115,107,.12);color:#eaa39d;border:1px solid rgba(229,115,107,.3)}
.money{font-weight:600}
.sm{color:var(--muted);font-size:11px}
.star{color:var(--green);font-weight:700;margin-left:4px}
.chk{display:inline-flex;align-items:center;gap:6px;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:8px 11px;font-size:12px;color:var(--muted);cursor:pointer}
.chk input{flex:none;min-width:0;width:15px;height:15px;accent-color:var(--green)}
a.btn{display:inline-block;background:var(--green);color:#06240f;font-weight:600;text-decoration:none;border-radius:999px;padding:6px 12px;font-size:12px;white-space:nowrap}
a.btn:hover{background:#54c270}
.clr{background:var(--surface2);border:1px solid var(--border);color:var(--muted);border-radius:10px;padding:9px 14px;font-size:12px;cursor:pointer}
.clr:hover{border-color:var(--green);color:var(--text)}
@media(max-width:719px){
  table{min-width:0}
  thead{position:absolute;left:-9999px}
  table,tbody,tr,td{display:block;width:100%}
  .tablewrap{border:none;overflow:visible}
  tr{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:10px 12px;margin-bottom:12px}
  tr:nth-child(even) td{background:transparent}
  td{border:none;padding:5px 0;display:flex;justify-content:space-between;gap:12px;text-align:right}
  td::before{content:attr(data-label);color:var(--dim);font-size:11px;text-transform:uppercase;letter-spacing:.04em;text-align:left;flex:none;padding-top:2px}
  td.r,td.c{text-align:right}
  .money{font-weight:700}
  td:last-child{justify-content:flex-end;padding-top:8px}
}
footer{color:var(--dim);font-size:12px;margin:22px 0 10px;line-height:1.7}
.gold{color:var(--amber);font-weight:600}


