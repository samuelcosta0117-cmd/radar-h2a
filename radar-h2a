:root{--bg:#0d1510;--surface:#121c15;--surface2:#172318;--border:#24352a;--green:#3fae5a;--green2:#2e7d32;--amber:#e0a92e;--text:#e7f0e9;--muted:#9db3a4;--dim:#6f857a;--red:#e5736b;}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;line-height:1.5;padding:16px;max-width:1200px;margin:0 auto}
h1{font-size:22px;font-weight:700;letter-spacing:-.02em}
.sub{color:var(--muted);font-size:13px;margin-top:4px}
.src{color:var(--dim);font-size:12px;margin-top:2px}
